<Window x:Class="RSS.LabelMaker.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="RSS Label Maker" Height="850" Width="1440" MinHeight="720" MinWidth="1120"
 WindowStartupLocation="CenterScreen" Background="#F5F6F8">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#20242B">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top" Margin="22,26,18,28">
     <TextBlock Text="RSS" Foreground="#D5AD5B" FontSize="30" FontWeight="Bold"/>
     <TextBlock Text="LABEL MAKER" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
     <TextBlock Text="RAZEEN SECURE SOLUTION" Foreground="#AEB4BD" FontSize="9" Margin="0,8,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="20,12,20,22">
     <Border Height="1" Background="#41464E" Margin="0,0,0,14"/>
     <TextBlock Text="FREE STANDALONE EDITION" Foreground="#AEB4BD" FontSize="9"/>
     <TextBlock Text=".NET 10  •  WINDOWS" Foreground="#777F89" FontSize="9" Margin="0,5,0,0"/>
    </StackPanel>
    <StackPanel>
     <TextBlock Text="WORKSPACE" Foreground="#777F89" FontSize="10" FontWeight="Bold" Margin="22,0,0,12"/>
     <Button x:Name="NavDashboard" Content="▦   Dashboard" Click="Nav_Click" Tag="Dashboard" HorizontalContentAlignment="Left" Margin="10,2" Background="#373D46" Foreground="White"/>
     <Button x:Name="NavProducts" Content="▤   Items Manager" Click="Nav_Click" Tag="Products" HorizontalContentAlignment="Left" Margin="10,2" Background="Transparent" Foreground="#D4D8DE"/>
     <Button x:Name="NavDesigner" Content="▧   Label Designer" Click="Nav_Click" Tag="Designer" HorizontalContentAlignment="Left" Margin="10,2" Background="Transparent" Foreground="#D4D8DE"/>
     <Button x:Name="NavTemplates" Content="▣   Templates" Click="Nav_Click" Tag="Templates" HorizontalContentAlignment="Left" Margin="10,2" Background="Transparent" Foreground="#D4D8DE"/>
     <Button x:Name="NavPrint" Content="▤   Print Manager" Click="Nav_Click" Tag="Print" HorizontalContentAlignment="Left" Margin="10,2" Background="Transparent" Foreground="#D4D8DE"/>
     <Button x:Name="NavImport" Content="⇧   Import / Export" Click="Nav_Click" Tag="Import" HorizontalContentAlignment="Left" Margin="10,2" Background="Transparent" Foreground="#D4D8DE"/>
     <Button x:Name="NavCompanyProfiles" Content="▣   Import By / Distributed By" Click="Nav_Click" Tag="CompanyProfiles" HorizontalContentAlignment="Left" Margin="10,2" Background="Transparent" Foreground="#D4D8DE"/>
     <TextBlock Text="INFORMATION" Foreground="#777F89" FontSize="10" FontWeight="Bold" Margin="22,28,0,12"/>
     <Button x:Name="NavAbout" Content="ⓘ   About RSS" Click="Nav_Click" Tag="About" HorizontalContentAlignment="Left" Margin="10,2" Background="Transparent" Foreground="#D4D8DE"/>
     <Button x:Name="NavContact" Content="✉   Contact Us" Click="Nav_Click" Tag="Contact" HorizontalContentAlignment="Left" Margin="10,2" Background="Transparent" Foreground="#D4D8DE"/>
     <TextBlock Text="PREFERENCES" Foreground="#777F89" FontSize="10" FontWeight="Bold" Margin="22,28,0,12"/>
     <Button x:Name="NavSettings" Content="⚙   Settings" Click="Nav_Click" Tag="Settings" HorizontalContentAlignment="Left" Margin="10,2" Background="Transparent" Foreground="#D4D8DE"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Grid.Row="0" Background="White" BorderBrush="#E6E8EB" BorderThickness="0,0,0,1">
    <Grid Margin="28,0">
     <StackPanel VerticalAlignment="Center">
      <TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="20" FontWeight="Bold" Foreground="#20242B"/>
      <TextBlock x:Name="PageSubtitle" Text="Your label production workspace" FontSize="11" Foreground="#77808C" Margin="0,3,0,0"/>
     </StackPanel>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
      <Border Background="#F8F2E6" CornerRadius="12" Padding="11,7" Margin="0,0,12,0">
       <TextBlock Text="●  LOCAL WORKSPACE" Foreground="#98702B" FontSize="10" FontWeight="Bold"/>
      </Border>
      <TextBlock Text="RSS" Foreground="#C69A43" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
     </StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="1" Margin="28">
    <!-- Dashboard -->
    <ScrollViewer x:Name="DashboardPage" VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <Border Background="#20242B" CornerRadius="10" Padding="26" Margin="0,0,0,20">
       <Grid>
        <StackPanel>
         <TextBlock Text="WELCOME TO RSS LABEL MAKER" Foreground="#D5AD5B" FontSize="10" FontWeight="Bold"/>
         <TextBlock Text="Design. Arrange. Print." Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,9,0,5"/>
         <TextBlock Text="Create accurate product labels for any Windows-compatible printer." Foreground="#C4CAD2" FontSize="13"/>
         <Button Content="Open Label Designer  →" Click="OpenDesigner_Click" HorizontalAlignment="Left" Background="#C69A43" Foreground="#20242B" Margin="0,20,0,0"/>
        </StackPanel>
        <Border Width="90" Height="90" CornerRadius="45" Background="#343A43" HorizontalAlignment="Right" VerticalAlignment="Center">
         <TextBlock Text="RSS" Foreground="#D5AD5B" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
       </Grid>
      </Border>
      <TextBlock Text="WORKSPACE OVERVIEW" FontSize="11" FontWeight="Bold" Foreground="#77808C" Margin="0,0,0,12"/>
      <UniformGrid Columns="3" Margin="0,0,0,22">
       <Border Background="White" CornerRadius="8" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="PRODUCTS" FontSize="10" Foreground="#77808C" FontWeight="Bold"/><TextBlock x:Name="ProductCount" Text="0" FontSize="28" FontWeight="Bold" Margin="0,8,0,2"/><TextBlock Text="Saved on this PC" Foreground="#77808C" FontSize="11"/></StackPanel></Border>
       <Border Background="White" CornerRadius="8" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="LABEL TEMPLATE" FontSize="10" Foreground="#77808C" FontWeight="Bold"/><TextBlock Text="Food Product" FontSize="22" FontWeight="Bold" Margin="0,8,0,2"/><TextBlock Text="Reference-style layout" Foreground="#77808C" FontSize="11"/></StackPanel></Border>
       <Border Background="White" CornerRadius="8" Padding="18"><StackPanel><TextBlock Text="PAPER PROFILE" FontSize="10" Foreground="#77808C" FontWeight="Bold"/><TextBlock Text="A4" FontSize="28" FontWeight="Bold" Margin="0,8,0,2"/><TextBlock Text="210 × 297 mm" Foreground="#77808C" FontSize="11"/></StackPanel></Border>
      </UniformGrid>
      <TextBlock Text="QUICK ACTIONS" FontSize="11" FontWeight="Bold" Foreground="#77808C" Margin="0,0,0,12"/>
      <UniformGrid Columns="3">
       <Button Content="＋  Add Product" Click="OpenProducts_Click" Background="White" Padding="18" Margin="0,0,12,0"/>
       <Button Content="▧  Design Label" Click="OpenDesigner_Click" Background="White" Padding="18" Margin="0,0,12,0"/>
       <Button Content="▤  Print Labels" Click="OpenPrint_Click" Background="White" Padding="18"/>
      </UniformGrid>
     </StackPanel>
    </ScrollViewer>
    <!-- Products -->
    <Grid x:Name="ProductsPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Background="White" CornerRadius="8" Padding="18" Margin="0,0,0,16">
      <StackPanel>
       <TextBlock Text="PRODUCT DETAILS" FontSize="11" FontWeight="Bold" Foreground="#77808C" Margin="0,0,0,12"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="Product name (English) — select existing or type new" FontSize="11" Margin="0,0,0,5"/><ComboBox x:Name="EnglishName" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" DisplayMemberPath="English" SelectionChanged="ProductName_SelectionChanged" KeyUp="ProductName_KeyUp" LostKeyboardFocus="ProductName_LostKeyboardFocus" ToolTip="Choose a saved product or type a new product name"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Product name (Sinhala)" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="SinhalaName" TextChanged="ProductField_TextChanged"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Product name (Tamil)" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="TamilName" TextChanged="ProductField_TextChanged"/></StackPanel>
       </Grid>
       <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,10,0"><TextBlock Text="M.F.D" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="Mfd" TextChanged="ProductField_TextChanged"/><CheckBox x:Name="MfdPrintOnPack" Content="Print on pack" FontSize="10" Margin="0,4,0,0" Checked="PrintOnPack_Changed" Unchecked="PrintOnPack_Changed"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="EXP.D" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="Expiry" TextChanged="ProductField_TextChanged"/><CheckBox x:Name="ExpiryPrintOnPack" Content="Print on pack" FontSize="10" Margin="0,4,0,0" Checked="PrintOnPack_Changed" Unchecked="PrintOnPack_Changed"/></StackPanel>
        <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="B.No" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="Batch" TextChanged="ProductField_TextChanged"/><CheckBox x:Name="BatchPrintOnPack" Content="Print on pack" FontSize="10" Margin="0,4,0,0" Checked="PrintOnPack_Changed" Unchecked="PrintOnPack_Changed"/></StackPanel>
        <StackPanel Grid.Column="3"><TextBlock Text="N.Wt" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="NetWeight" Text="" TextChanged="ProductField_TextChanged"/><CheckBox x:Name="NetWeightPrintOnPack" Content="Print on pack" FontSize="10" Margin="0,4,0,0" Checked="PrintOnPack_Changed" Unchecked="PrintOnPack_Changed"/></StackPanel>
       </Grid>
       <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,10,0"><TextBlock Text="Sugar (g/100g)" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="Sugar" TextChanged="ProductField_TextChanged"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Salt (g/100g)" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="Salt" TextChanged="ProductField_TextChanged"/></StackPanel>
        <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="Fat (g/100g)" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="Fat" TextChanged="ProductField_TextChanged"/></StackPanel>
        <StackPanel Grid.Column="3"><TextBlock Text="M.R.P. (Rs.)" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="Mrp" TextChanged="ProductField_TextChanged"/></StackPanel>
       </Grid>
       <Border Background="#F7F8FA" Padding="12" Margin="0,12,0,0" CornerRadius="6">
        <StackPanel>
         <TextBlock Text="IMPORT BY / DISTRIBUTED BY" FontSize="11" FontWeight="Bold" Foreground="#77808C" Margin="0,0,0,8"/>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,10,0">
           <TextBlock Text="Import By profile" FontSize="11"/>
           <ComboBox x:Name="ImportByProfile" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="ImportByProfile_SelectionChanged" Margin="0,4,0,6"/>
           <TextBlock Text="Name (product override)" FontSize="10" Foreground="#77808C"/>
           <TextBox x:Name="ImportByName" TextChanged="ProductField_TextChanged" Margin="0,3,0,5"/>
           <TextBlock Text="Address (product override)" FontSize="10" Foreground="#77808C"/>
           <TextBox x:Name="ImportByAddress" TextChanged="ProductField_TextChanged" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" VerticalScrollBarVisibility="Auto" Margin="0,3,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1">
           <TextBlock Text="Distributed By profile" FontSize="11"/>
           <ComboBox x:Name="DistributedByProfile" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="DistributedByProfile_SelectionChanged" Margin="0,4,0,6"/>
           <TextBlock Text="Name (product override)" FontSize="10" Foreground="#77808C"/>
           <TextBox x:Name="DistributedByName" TextChanged="ProductField_TextChanged" Margin="0,3,0,5"/>
           <TextBlock Text="Address (product override)" FontSize="10" Foreground="#77808C"/>
           <TextBox x:Name="DistributedByAddress" TextChanged="ProductField_TextChanged" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" VerticalScrollBarVisibility="Auto" Margin="0,3,0,0"/>
          </StackPanel>
         </Grid>
         <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="Copies" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="Copies" Text="1" TextChanged="PrintCapacityInputs_Changed"/></StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal"><Button Content="New Product" Click="NewProduct_Click" Padding="12,9" Margin="0,0,8,0"/><Button x:Name="SaveProductButton" Content="Save Product" Click="SaveProduct_Click" Background="#C69A43" Foreground="#20242B" Padding="18,9"/></StackPanel>
         </Grid>
        </StackPanel>
       </Border>
       <Border Background="#F7F8FA" Padding="12" Margin="0,12,0,0" CornerRadius="6">
        <StackPanel>
         <TextBlock Text="BOX &amp; PER-PIECE PRICING" FontWeight="Bold" FontSize="11" Foreground="#77808C" Margin="0,0,0,8"/>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,10,0"><TextBlock Text="Pieces per Box" FontSize="11"/><TextBox x:Name="PiecesPerBox" TextChanged="ProductField_TextChanged" Margin="0,4,0,0"/></StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Box Price (Rs.)" FontSize="11"/><TextBox x:Name="BoxPrice" TextChanged="ProductField_TextChanged" Margin="0,4,0,0"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Per-piece price" FontSize="11"/><CheckBox x:Name="ShowPerPiecePrice" Content="Show on label" Checked="PerPiecePricing_Changed" Unchecked="PerPiecePricing_Changed" Margin="0,7,0,0"/></StackPanel>
         </Grid>
         <StackPanel x:Name="PerPiecePricePanel" Visibility="Collapsed" Margin="0,8,0,0">
          <TextBlock Text="Calculation mode" FontSize="11"/>
          <ComboBox x:Name="PerPiecePricingMode" SelectedIndex="0" SelectionChanged="PerPiecePricingMode_Changed" Margin="0,4,0,6">
           <ComboBoxItem Content="Automatic — Box Price ÷ Pieces per Box"/>
           <ComboBoxItem Content="Manual — enter per-piece price"/>
          </ComboBox>
          <TextBox x:Name="ManualPerPiecePrice" Visibility="Collapsed" TextChanged="ProductField_TextChanged" ToolTip="Manual per-piece price (Rs.)"/>
          <TextBlock x:Name="CalculatedPerPiecePrice" Text="Enter a valid box price and pieces per box." Foreground="#4E7B5C" FontSize="11"/>
         </StackPanel>
        </StackPanel>
       </Border>
       <TextBlock x:Name="ProductStatus" Foreground="#4E7B5C" FontSize="11" Margin="0,10,0,0"/>
      </StackPanel>
     </Border>
     <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16">
      <DockPanel>
       <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBox x:Name="ProductSearch" Width="170" ToolTip="Search products by name, batch or MRP" TextChanged="ProductSearch_TextChanged" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
        <Button Content="Import Excel" Click="ImportProductsExcel_Click" Padding="12,6" Margin="0,0,8,0"/>
        <Button Content="Export Excel" Click="ExportProductsExcel_Click" Padding="12,6" Margin="0,0,8,0"/>
        <Button Content="Edit selected" Click="EditProduct_Click" Padding="12,6" Margin="0,0,8,0"/>
        <Button Content="Delete selected" Click="DeleteProduct_Click" Padding="12,6"/>
       </StackPanel>
       <TextBlock Text="ITEMS MANAGER" FontSize="11" FontWeight="Bold" Foreground="#77808C" VerticalAlignment="Center"/>
      </DockPanel>
       <DataGrid x:Name="ProductsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
        <DataGrid.Columns>
         <DataGridTextColumn Header="Product name" Binding="{Binding English}" Width="2*"/>
         <DataGridTextColumn Header="Sinhala" Binding="{Binding Sinhala}" Width="*"/>
         <DataGridTextColumn Header="Tamil" Binding="{Binding Tamil}" Width="*"/>
         <DataGridTextColumn Header="Batch" Binding="{Binding Batch}" Width="*"/>
         <DataGridTextColumn Header="M.R.P. (Rs.)" Binding="{Binding Mrp}" Width="*"/>
        </DataGrid.Columns>
       </DataGrid>
      </DockPanel>
     </Border>
    </Grid>
    <!-- Designer -->
    <Grid x:Name="DesignerPage" Visibility="Collapsed">
     <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="17" Margin="0,0,16,0">
      <StackPanel>
       <TextBlock Text="LABEL SETTINGS" FontWeight="Bold" FontSize="11" Foreground="#77808C" Margin="0,0,0,14"/>
       <TextBlock Text="Template" FontSize="11"/><ComboBox SelectedIndex="0" Margin="0,5,0,12"><ComboBoxItem Content="Food Product Label"/><ComboBoxItem Content="General Product Label"/><ComboBoxItem Content="Barcode &amp; Price Label"/></ComboBox>
       <TextBlock Text="Label width (mm)" FontSize="11"/><TextBox x:Name="LabelWidth" Text="70" Margin="0,5,0,12" TextChanged="PrintCapacityInputs_Changed"/>
       <TextBlock Text="Label height (mm)" FontSize="11"/><TextBox x:Name="LabelHeight" Text="45" Margin="0,5,0,12" TextChanged="PrintCapacityInputs_Changed"/>
       <TextBlock Text="Paper" FontSize="11"/><ComboBox x:Name="DesignerPaperSize" SelectedIndex="0" Margin="0,5,0,12"><ComboBoxItem Content="A4 — 210 × 297 mm"/><ComboBoxItem Content="A5 — 148 × 210 mm"/><ComboBoxItem Content="Letter"/></ComboBox>
       <TextBlock Text="Layout" FontSize="11"/><ComboBox SelectedIndex="0" Margin="0,5,0,12"><ComboBoxItem Content="Automatic rows &amp; columns"/><ComboBoxItem Content="Manual rows &amp; columns"/></ComboBox>
       <Button Content="Apply dimensions" Click="ApplyLayout_Click" Background="#C69A43" Margin="0,8,0,0"/>
       <TextBlock x:Name="LayoutStatus" Text="A4 sheet · Actual size preview" Foreground="#77808C" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0"/>
       <Border Height="1" Background="#E6E8EB" Margin="0,16,0,12"/>
       <TextBlock Text="LOGO WATERMARK" FontWeight="Bold" FontSize="11" Foreground="#77808C" Margin="0,0,0,8"/>
       <Button Content="Choose logo image…" Click="ChooseWatermark_Click" HorizontalAlignment="Stretch"/>
       <TextBlock x:Name="WatermarkFileName" Text="No logo selected" Foreground="#77808C" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,8"/>
       <TextBlock Text="Watermark opacity" FontSize="11"/>
       <Slider x:Name="WatermarkOpacitySlider" Minimum="0" Maximum="1" Value="0.20" TickFrequency="0.05" IsSnapToTickEnabled="False" ValueChanged="WatermarkOpacity_ValueChanged" Margin="0,6,0,0"/>
       <TextBlock x:Name="WatermarkOpacityValue" Text="20%" Foreground="#77808C" FontSize="10" HorizontalAlignment="Right"/>
       <Button Content="Remove watermark" Click="RemoveWatermark_Click" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
      </StackPanel>
     </Border>
     <Border Grid.Column="1" Background="#E9EBEE" CornerRadius="8" Padding="24">
      <Grid>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock Text="DESIGN CANVAS" FontWeight="Bold" FontSize="11" Foreground="#77808C"/><TextBlock Text="   ·   100%" FontSize="11" Foreground="#77808C"/></StackPanel>
       <Border x:Name="PreviewLabelBorder" Width="490" Height="315" Background="White" BorderBrush="#20242B" BorderThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="14">
        <Grid>
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <Image x:Name="PreviewWatermark" Grid.RowSpan="5" Source="{x:Null}" Stretch="Uniform" Opacity="0.20" Visibility="Collapsed" IsHitTestVisible="False"/>
         <TextBlock x:Name="PreviewEnglish" Text="PRODUCT NAME" Foreground="#C83232" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center"/>
         <TextBlock x:Name="PreviewLocal" Grid.Row="1" Text="සිංහල නම  •  தமிழ் பெயர்" Foreground="#C83232" FontSize="14" HorizontalAlignment="Center" Margin="0,1,0,8"/>
         <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel FontSize="12" VerticalAlignment="Center">
           <TextBlock x:Name="PreviewMfd" Text="M.F.D :  —"/>
           <TextBlock x:Name="PreviewExpiry" Text="EXP.D :  —"/>
           <TextBlock x:Name="PreviewBatch" Text="B.No :  —"/>
           <TextBlock x:Name="PreviewNetWeight" Text="N.Wt :  —"/>
           <TextBlock x:Name="PreviewImporter" Text="" TextWrapping="Wrap" Margin="0,5,0,0"/>
           <TextBlock x:Name="PreviewDistributor" Text="" TextWrapping="Wrap"/>
          </StackPanel>
         </Grid>
         <StackPanel Grid.Row="3" Margin="0,8">
          <TextBlock x:Name="PreviewMrp" Text="M.R.P. (Rs.)  —" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
          <TextBlock x:Name="PreviewPerPiece" Text="" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Visibility="Collapsed"/>
         </StackPanel>
         <Grid Grid.Row="4">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Background="#C94343" Margin="1" Padding="5"><StackPanel><TextBlock Text="SUGAR" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11"/><TextBlock Text="සීනි  •  சர்க்கரை" Foreground="White" FontSize="8" HorizontalAlignment="Center"/><TextBlock x:Name="PreviewSugar" Text="— g/100g" Background="White" Foreground="#222" HorizontalAlignment="Stretch" TextAlignment="Center" Padding="2"/></StackPanel></Border>
          <Border Grid.Column="1" Background="#458A58" Margin="1" Padding="5"><StackPanel><TextBlock Text="SALT" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11"/><TextBlock Text="ලුණු  •  உப்பு" Foreground="White" FontSize="8" HorizontalAlignment="Center"/><TextBlock x:Name="PreviewSalt" Text="— g/100g" Background="White" Foreground="#222" HorizontalAlignment="Stretch" TextAlignment="Center" Padding="2"/></StackPanel></Border>
          <Border Grid.Column="2" Background="#D99B37" Margin="1" Padding="5"><StackPanel><TextBlock Text="FAT" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" FontSize="11"/><TextBlock Text="මේදය  •  கொழுப்பு" Foreground="White" FontSize="8" HorizontalAlignment="Center"/><TextBlock x:Name="PreviewFat" Text="— g/100g" Background="White" Foreground="#222" HorizontalAlignment="Stretch" TextAlignment="Center" Padding="2"/></StackPanel></Border>
         </Grid>
        </Grid>
       </Border>
       <TextBlock Text="Reference food-label composition · editable fields and physical dimensions" Foreground="#77808C" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
      </Grid>
     </Border>
    </Grid>
    <!-- Templates -->
    <Grid x:Name="TemplatesPage" Visibility="Collapsed">
     <StackPanel>
      <TextBlock Text="BUILT-IN TEMPLATES" FontSize="11" FontWeight="Bold" Foreground="#77808C" Margin="0,0,0,14"/>
      <UniformGrid Columns="3">
       <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="FOOD PRODUCT LABEL" FontWeight="Bold"/><TextBlock Text="Reference-style food label with Sugar, Salt and Fat panels." TextWrapping="Wrap" Foreground="#77808C" Margin="0,8,0,18"/><Button Content="Open in Designer" Click="OpenDesigner_Click" Background="#F8F2E6"/></StackPanel></Border>
       <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="GENERAL PRODUCT LABEL" FontWeight="Bold"/><TextBlock Text="Flexible product information and branding layout." TextWrapping="Wrap" Foreground="#77808C" Margin="0,8,0,18"/><Button Content="Open in Designer" Click="OpenDesigner_Click"/></StackPanel></Border>
       <Border Background="White" CornerRadius="8" Padding="20"><StackPanel><TextBlock Text="BARCODE &amp; PRICE LABEL" FontWeight="Bold"/><TextBlock Text="Compact product identification and price layout." TextWrapping="Wrap" Foreground="#77808C" Margin="0,8,0,18"/><Button Content="Open in Designer" Click="OpenDesigner_Click"/></StackPanel></Border>
      </UniformGrid>
     </StackPanel>
    </Grid>
    <!-- Print manager -->
    <Grid x:Name="PrintPage" Visibility="Collapsed">
     <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,16,0">
      <StackPanel>
       <TextBlock Text="PRINT SETUP" FontSize="11" FontWeight="Bold" Foreground="#77808C" Margin="0,0,0,16"/>
       <TextBlock Text="Printer" FontSize="11"/><ComboBox x:Name="PrinterList" Margin="0,5,0,14"/>
       <TextBlock Text="Paper size" FontSize="11"/><ComboBox x:Name="PrintPaperSize" SelectedIndex="0" Margin="0,5,0,10" SelectionChanged="PrintCapacityInputs_Changed"><ComboBoxItem Content="A4"/><ComboBoxItem Content="A5"/><ComboBoxItem Content="Letter"/><ComboBoxItem Content="Custom"/></ComboBox>
       <TextBlock Text="Custom page width (mm)" FontSize="11"/><TextBox x:Name="CustomPageWidth" Text="210" Margin="0,4,0,8" TextChanged="PrintCapacityInputs_Changed"/>
       <TextBlock Text="Custom page height (mm)" FontSize="11"/><TextBox x:Name="CustomPageHeight" Text="297" Margin="0,4,0,10" TextChanged="PrintCapacityInputs_Changed"/>
       <TextBlock Text="Orientation" FontSize="11"/><ComboBox x:Name="PrintOrientation" SelectedIndex="0" Margin="0,5,0,10" SelectionChanged="PrintCapacityInputs_Changed"><ComboBoxItem Content="Portrait"/><ComboBoxItem Content="Landscape"/></ComboBox>
       <TextBlock Text="Page margins (mm)" FontSize="11" FontWeight="Bold" Margin="0,4,0,4"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,6,0"><TextBlock Text="Left" FontSize="10"/><TextBox x:Name="MarginLeft" Text="8" TextChanged="PrintCapacityInputs_Changed"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Right" FontSize="10"/><TextBox x:Name="MarginRight" Text="8" TextChanged="PrintCapacityInputs_Changed"/></StackPanel>
       </Grid>
       <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,6,0"><TextBlock Text="Top" FontSize="10"/><TextBox x:Name="MarginTop" Text="8" TextChanged="PrintCapacityInputs_Changed"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Bottom" FontSize="10"/><TextBox x:Name="MarginBottom" Text="8" TextChanged="PrintCapacityInputs_Changed"/></StackPanel>
       </Grid>
       <TextBlock Text="Label gaps (mm)" FontSize="11" FontWeight="Bold" Margin="0,10,0,4"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,6,0"><TextBlock Text="Horizontal" FontSize="10"/><TextBox x:Name="HorizontalLabelGap" Text="2" TextChanged="PrintCapacityInputs_Changed"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Vertical" FontSize="10"/><TextBox x:Name="VerticalLabelGap" Text="2" TextChanged="PrintCapacityInputs_Changed"/></StackPanel>
       </Grid>
       <TextBlock Text="ITEMS ON THIS SHEET" FontSize="11" FontWeight="Bold" Margin="0,14,0,5"/>
       <CheckBox x:Name="EnableMultipleLabels" Content="Enable Multiple Labels (different products on one sheet)" IsChecked="False" Checked="PrintCapacityInputs_Changed" Unchecked="PrintCapacityInputs_Changed" FontSize="11" Margin="0,0,0,7"/>
       <TextBlock Text="Tick every product to include it. Copies are taken from each product's Copies field." FontSize="10" Foreground="#77808C" TextWrapping="Wrap" Margin="0,0,0,6"/>
       <ListBox x:Name="PrintProductsList" ItemsSource="{Binding}" MaxHeight="190" BorderBrush="#E6E8EB">
        <ListBox.ItemTemplate>
         <DataTemplate>
          <CheckBox Content="{Binding English}" IsChecked="{Binding IsPrintSelected, Mode=TwoWay}" Padding="3" Checked="PrintProductSelection_Changed" Unchecked="PrintProductSelection_Changed" />
         </DataTemplate>
        </ListBox.ItemTemplate>
       </ListBox>
       <Button Content="Select all products" Click="SelectAllPrintProducts_Click" HorizontalAlignment="Left" Margin="0,6,0,0"/>
       <Button Content="Clear selection" Click="ClearPrintProducts_Click" HorizontalAlignment="Left" Margin="0,4,0,0"/>
       <Button Content="Refresh printers" Click="RefreshPrinters_Click" HorizontalAlignment="Left"/>
       <Button Content="Print Preview" Click="OpenPrintPreview_Click" Background="#C69A43" Margin="0,18,0,0" HorizontalAlignment="Left"/>
       <TextBlock Text="Select products above. Enable Multiple Labels to combine different products on the same sheet." Foreground="#77808C" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
       <TextBlock x:Name="PrintCapacitySummary" Text="Capacity will appear when page and label settings are valid." Foreground="#4E7B5C" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"/>
              <Button Content="Print test page" Click="TestPrint_Click" Background="#C69A43" Margin="0,18,0,0" HorizontalAlignment="Left"/>
       <TextBlock x:Name="PrintStatus" Text="Printer selection is read from Windows." Foreground="#77808C" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
     <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20">
      <StackPanel>
       <TextBlock Text="SHEET SUMMARY" FontSize="11" FontWeight="Bold" Foreground="#77808C"/>
       <TextBlock x:Name="PrintLayoutSummary" Text="A4 · Portrait&#10;210 × 297 mm" FontSize="16" FontWeight="Bold" Margin="0,14,0,4" TextWrapping="Wrap"/>
       <Border Height="1" Background="#E6E8EB" Margin="0,18"/>
       <TextBlock Text="LABEL PLACEMENT" FontWeight="Bold" FontSize="11"/>
       <TextBlock Text="Rows and columns will be calculated from label size, gaps and margins. The selected printer's printable area must also be checked." TextWrapping="Wrap" Foreground="#77808C" FontSize="12" Margin="0,8,0,0"/>
       <TextBlock Text="Print scale: 100%" Foreground="#4E7B5C" FontWeight="Bold" Margin="0,18,0,0"/>
      </StackPanel>
     </Border>
    </Grid>

    <Grid x:Name="CompanyProfilesPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,16">
      <StackPanel>
       <TextBlock Text="COMPANY / PERSON PROFILE" FontSize="11" FontWeight="Bold" Foreground="#77808C" Margin="0,0,0,12"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="Profile type" FontSize="11" Margin="0,0,0,5"/><ComboBox x:Name="CompanyProfileType" SelectedIndex="0"><ComboBoxItem Content="Import By"/><ComboBoxItem Content="Distributed By"/></ComboBox></StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Company / person name" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="CompanyProfileName"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Phone / contact (optional)" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="CompanyProfileContact"/></StackPanel>
       </Grid>
       <TextBlock Text="Full address" FontSize="11" Margin="0,12,0,5"/>
       <TextBox x:Name="CompanyProfileAddress" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" VerticalScrollBarVisibility="Auto"/>
       <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="SaveCompanyProfileButton" Content="Save Profile" Click="SaveCompanyProfile_Click" Background="#C69A43" Foreground="#20242B" Padding="18,8" Margin="0,0,8,0"/><Button Content="Clear" Click="ClearCompanyProfile_Click" Padding="16,8"/></StackPanel>
       <TextBlock x:Name="CompanyProfileStatus" Foreground="#4E7B5C" FontSize="11" Margin="0,9,0,0"/>
      </StackPanel>
     </Border>
     <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="18">
      <DockPanel>
       <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Edit selected" Click="EditCompanyProfile_Click" Padding="12,6" Margin="0,0,8,0"/><Button Content="Delete selected" Click="DeleteCompanyProfile_Click" Padding="12,6"/></StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="SAVED PROFILES" FontSize="11" FontWeight="Bold" Foreground="#77808C"/><TextBlock x:Name="CompanyProfileCount" Text="0" FontSize="11" Foreground="#C69A43" FontWeight="Bold" Margin="10,0,0,0"/></StackPanel>
       </DockPanel>
       <DataGrid x:Name="CompanyProfilesGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
        <DataGrid.Columns><DataGridTextColumn Header="Type" Binding="{Binding ProfileType}" Width="140"/><DataGridTextColumn Header="Company / Person" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Full address" Binding="{Binding Address}" Width="3*"/><DataGridTextColumn Header="Contact" Binding="{Binding Contact}" Width="*"/></DataGrid.Columns>
       </DataGrid>
      </DockPanel>
     </Border>
    </Grid>

    <Grid x:Name="AboutPage" Visibility="Collapsed">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <Border Background="#20242B" CornerRadius="10" Padding="28" Margin="0,0,0,18">
        <StackPanel>
         <TextBlock Text="RAZEEN SECURE SOLUTION" Foreground="#D5AD5B" FontSize="11" FontWeight="Bold"/>
         <TextBlock Text="Technology that secures, connects and simplifies." Foreground="White" FontSize="25" FontWeight="Bold" TextWrapping="Wrap" Margin="0,10,0,8"/>
         <TextBlock Text="Razeen Secure Solution (RSS) is a technology company established in 2015, delivering software, security and IT solutions for businesses and individuals." Foreground="#D5D9DF" FontSize="13" TextWrapping="Wrap" MaxWidth="780"/>
         <Button Content="Website  ↗" Click="OpenWebsite_Click" HorizontalAlignment="Left" Background="#C69A43" Foreground="#20242B" Padding="18,9" Margin="0,18,0,0"/>
        </StackPanel>
       </Border>
       <TextBlock Text="OUR SERVICES" FontSize="11" FontWeight="Bold" Foreground="#77808C" Margin="0,0,0,12"/>
       <UniformGrid Columns="3" Margin="0,0,0,18">
        <Border Background="White" CornerRadius="8" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="SOFTWARE DEVELOPMENT" FontWeight="Bold" FontSize="12"/><TextBlock Text="Mobile and PC applications, business software and AI-powered solutions." Foreground="#77808C" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border>
        <Border Background="White" CornerRadius="8" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="CCTV &amp; SECURITY" FontWeight="Bold" FontSize="12"/><TextBlock Text="CCTV camera installation and security system solutions." Foreground="#77808C" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border>
        <Border Background="White" CornerRadius="8" Padding="18"><StackPanel><TextBlock Text="IT &amp; NETWORKING" FontWeight="Bold" FontSize="12"/><TextBlock Text="Networking, system administration, troubleshooting and cloud services." Foreground="#77808C" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border>
       </UniformGrid>
       <Border Background="White" CornerRadius="8" Padding="20">
        <StackPanel>
         <TextBlock Text="RSS LABEL MAKER" FontWeight="Bold" FontSize="13"/>
         <TextBlock Text="A free, standalone Windows label-design application developed by Razeen Secure Solution. Designed for product information, nutrition values, label layout and Windows-compatible printers." Foreground="#77808C" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,14"/>
         <TextBlock Text="Phone: +94 77 115 5504  |  +94 70 155 5504" FontSize="12" Margin="0,2"/>
         <TextBlock Text="Email: riyaz@rssapps.net" FontSize="12" Margin="0,2"/>
        </StackPanel>
       </Border>
      </StackPanel>
     </ScrollViewer>
    </Grid>
    <Grid x:Name="ContactPage" Visibility="Collapsed">
     <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="White" CornerRadius="8" Padding="24" Margin="0,0,16,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
       <StackPanel>
        <TextBlock Text="SEND US A MESSAGE" FontSize="11" FontWeight="Bold" Foreground="#77808C" Margin="0,0,0,16"/>
        <TextBlock Text="Your name *" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="ContactName" MaxLength="120" Margin="0,0,0,12"/>
        <TextBlock Text="Your email *" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="ContactEmail" MaxLength="254" Margin="0,0,0,12"/>
        <TextBlock Text="Phone (optional)" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="ContactPhone" MaxLength="40" Margin="0,0,0,12"/>
        <TextBlock Text="Subject *" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="ContactSubject" MaxLength="180" Margin="0,0,0,12"/>
        <TextBlock Text="Message *" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="ContactMessage" MaxLength="5000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="145" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14"/>
        <StackPanel Orientation="Horizontal"><Button Content="Prepare &amp; Send Email" Click="SendContactMessage_Click" Background="#C69A43" Foreground="#20242B" Padding="18,9" Margin="0,0,8,0"/><Button Content="Clear form" Click="ClearContactForm_Click" Padding="16,9"/></StackPanel>
        <TextBlock x:Name="ContactStatus" Foreground="#4E7B5C" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
       </StackPanel>
      </ScrollViewer>
     </Border>
     <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="22">
      <StackPanel>
       <TextBlock Text="CONTACT DETAILS" FontSize="11" FontWeight="Bold" Foreground="#77808C" Margin="0,0,0,14"/>
       <TextBlock Text="Razeen Secure Solution" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
       <Button Content="Website  ↗" Click="OpenWebsite_Click" HorizontalAlignment="Left" Background="#F8F2E6" Foreground="#98702B" Padding="14,7" Margin="0,18,0,0"/>
       <TextBlock Text="Phone" FontSize="10" Foreground="#77808C" Margin="0,16,0,4"/>
       <TextBlock Text="+94 77 115 5504" FontSize="13"/>
       <TextBlock Text="+94 70 155 5504" FontSize="13" Margin="0,4,0,0"/>
       <TextBlock Text="Email" FontSize="10" Foreground="#77808C" Margin="0,16,0,4"/>
       <TextBlock Text="riyaz@rssapps.net" FontSize="13"/>
       <Border Height="1" Background="#E6E8EB" Margin="0,20"/>
       <TextBlock Text="Email sending" FontWeight="Bold" FontSize="11"/>
       <TextBlock Text="The form prepares your message in the default email application. Review the draft and press Send there. No message is sent without your confirmation." Foreground="#77808C" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
      </StackPanel>
     </Border>
    </Grid>
    <!-- Import and settings placeholder pages -->
    <Grid x:Name="ImportPage" Visibility="Collapsed"><Border Background="White" CornerRadius="8" Padding="28"><StackPanel><TextBlock Text="IMPORT / EXPORT" FontSize="18" FontWeight="Bold"/><TextBlock Text="Excel and CSV field mapping, validation preview and PDF export are planned for the next implementation stages." Foreground="#77808C" Margin="0,10,0,0"/></StackPanel></Border></Grid>
    <Grid x:Name="SettingsPage" Visibility="Collapsed"><Border Background="White" CornerRadius="8" Padding="28"><StackPanel><TextBlock Text="APPLICATION SETTINGS" FontSize="18" FontWeight="Bold"/><TextBlock Text="Local data location, appearance, translation provider and backup settings will be configured here." Foreground="#77808C" Margin="0,10,0,0"/><Border Height="1" Background="#E6E8EB" Margin="0,22,0,18"/><TextBlock Text="ACCOUNT" FontWeight="Bold" FontSize="12"/><TextBlock Text="This PC uses a protected, verified device session. Signing out removes this PC’s offline access." Foreground="#77808C" TextWrapping="Wrap" Margin="0,8,0,12"/><Button Content="Sign out" Width="120" HorizontalAlignment="Left" Background="#A33B32" Foreground="White" Click="SignOut_Click"/></StackPanel></Border></Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>
